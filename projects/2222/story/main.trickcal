# 《雨夜的末班车》：剧情引擎入门教程
# 以 # 开头的是注释，只供阅读，不会出现在剧情画面中。
# 本文件按从上到下的顺序执行；分支和 jump 会改变执行顺序。

# 一、声明素材
# 路径从项目根目录开始，使用正斜杠；素材要在使用前声明。
# Spine(...) 指向包含同名骨骼、atlas 和贴图的文件夹。
# 头像先用 image 声明；角色的 name、avatar 和 avatarBg 是显示名、默认头像和头像底色。
image erpin_avatar = "assets/herohead/erpin.png"
image ner_avatar = "assets/herohead/ner.png"
define erpin = Spine("assets/spine/standing/erpin", name="埃尔芬", avatar=erpin_avatar, avatarBg="#e7b35f")
define ner = Spine("assets/spine/standing/ner", name="尼尔", avatar=ner_avatar, avatarBg="#9fc766")
define emoticon = Spine("assets/spine/emoticon")
image station = "assets/bg/elf_city_night.png"
image hall = "assets/bg/elf_arthall_night.png"
default saw_signal = false
# 示例音频是静音文件；替换为自己有权使用的音频后才能听到声音。
define audio.rain = "assets/audio/silent.wav"

# 二、开场和背景
# scene bg black 是内置黑屏；opening 的 hold 是入场结束后的停留秒数。
scene bg black
# 预设参数只影响紧接着的章节开场，不修改预设文件。
preset 章节开场 uiScale 0.95
opening 1 "2222" hold 0 cinema on bg station
scene bg station
# 音频命令在下一段剧情开始时执行；loop 表示循环。
audio play rain loop fadeIn 1s
# 地点标识可设置位置、缩放、旋转和不透明度。
preset 地点标识 uiY -20
location "王都 · 中央车站" hold 0
# 主播和简报新闻框的样式、文字、阴影和入场时长可逐条调整。
# entryDuration 单位为秒，默认 0.5；这里只把主播框入场放慢到 0.8 秒。
preset 新闻框·主播 fontSize 52 shadowX 16 shadowY 12 entryDuration 0.8
news anchor "站台广播：末班车因暴雨晚点。"
preset 新闻框·简报 textColor "#012060"
news summary "请旅客留意站台广播。"
# 旁白框使用 NarrationText 入场，preset 参数只作用于下一段。
preset 旁白框 fontSize 52
narration "暴雨落在空荡荡的站台上，末班车迟迟没有到来。"

# 三、显示角色与播放 Spine 动作
# left、right、center 是预设站位；face 1 朝右，face -1 朝左。
# pose 为模型中实际存在的动作名称。
show erpin at right face 1 pose Idle_1
# alpha 是不透明度，brightness 是此角色独立亮度；1 是原值，0 是全暗。
show ner at left face -1 pose Idle_1 alpha 1 brightness 0.85
skin erpin Normal
anim erpin Happy_1 fade 0.25

# 四、对话和预设
# preset 只作用于紧接着的下一条兼容对话；要重复使用，需要再次写出。
# manga 是箭头尾巴的漫画气泡，think 是圆点尾巴的思考气泡。
# 紫色内心漫画气泡要搭配 manga，普通对话框使用 normal。
# 下列参数只覆盖本条对话，不修改预设文件；阴影 X 向右、Y 向下为正。
# 颜色使用六位十六进制并放在英文双引号内；透明度 0 为透明，1 为不透明。
preset 漫画对话气泡 tail br bubbleWidth 800 shadowX 18 shadowY 20 shadowColor "#3b2852" shadowAlpha 0.45
erpin manga "等等我！这趟车还没来吧？"
# 气泡文字过长时可选 grow、shrink、scroll 或 clip；这里只修改本句。
preset 漫画对话气泡 tail tl overflow shrink bubbleMinHeight 320
erpin manga "列车晚点了，站台上的广播也一直没有响。"
preset 紫色内心气泡
ner manga "她总是在最后一刻赶到。"
preset 普通对话框
# ner 指定说话者；name 可仅覆盖这句显示的名字。
ner normal "还没有。广播说列车晚点了。" name "尼尔"
erpin normal "太好了，我差一点以为自己要走回家。"

# cloud 是云朵内心框；blast 是爆炸对话框。
# 也可选择有名字的云朵框，以及无名字的普通框和爆炸框。
preset 云朵对话框·有名字
erpin cloud "雨声好像越来越大了。"
preset 普通对话框·无名字
ner normal "列车应该快到了。"
preset 爆炸框·无名字
erpin blast "那边有动静！"
preset 云朵内心框
erpin cloud "（不过，站台另一头的灯为什么一直在闪？）"
# oneshot 与台词同时播放一次性 Spine 表情；素材必须先用 define 声明。
parallel:
  after 100ms:
    oneshot spine emoticon anim Idea at 960,520 scale 0.8
  preset 爆炸框
  ner normal "小心，地面很滑！"

# clear 显示独白框；后续连续写 clearRe 时保留框体，并重新播放头像和名字的入场。
# 如果前面没有独白框，或者这句独白被 after 延时，clearRe 会先完整显示框体。
preset 紫色内心独白框 avatarBg "#75a659"
# avatar 必须引用上面声明过的 image；本句覆盖角色默认头像和底色。
ner clear "雨似乎比刚才更大了。" name "尼尔" avatar ner_avatar avatarBg "#75a659"
erpin clearRe "我们先到候车厅避雨吧。"

# 动画字幕适合演出中的短句，名字显示为对应角色的名称。
preset 动画字幕 textColor "#ffffff"
ner anime "再等一会儿吧。"

# 五、富文本
# 这是普通对话框内的逐字效果，不是独立对象。
# speed 是每字间隔的秒数；标点后额外等待 punctuationPause 秒。
preset 普通打字机 speed 0.06 punctuationPause 0.2 typeSpeed 1
ner normal "听，雨声变小了。"
# color 标签改变其中的颜色；pause 在后续文字前暂停，单位为秒。
# speed 标签调整局部打字速度，结束标签后恢复原速。
erpin normal "看，那盏灯<color=#ffcc00>又亮了</color>。<pause=0.3><speed=0.5>我们要不要去看看？</speed>"

# 六、动作和镜头
# parallel 中可以直接写角色台词；move 与它同时播放。
# x 500 -> 700 指从指定坐标移动到目标坐标；by 是相对偏移。
parallel:
  # 先开始移动，200 毫秒后再显示气泡和开始打字。
  after 200ms:
    erpin manga "我走近一点看看。"
  move erpin x by -120 in 0.8s ease InOutSine
  # after 的秒数从本次 parallel 开始计算，可用于延时动作。
  after 0.2s:
    move ner brightness 0.85 -> 1 in 0.6s ease Linear
    # 角色动作和镜头命令也可以延时触发。
    anim ner Idle_1 fade 0.25
    camera zoom 1.05
    # 从 1.05 平滑放大到 1.08，耗时 0.6 秒。
    camera zoom 1.05 -> 1.08 in 0.6s ease InOutSine
    # 延时音频也可以写在这里；示例素材是静音文件。
    audio play rain loop
camera zoom 1.08
camera follow erpin offset 0,300
ner normal "不要走得太远。"
camera reset

# 图片也能在演出中登场、绑定角色、跟随移动并在指定位置解绑。
# 故意先写 400ms、后写 200ms：事件按时间执行，不按行号提前绑定。
parallel:
  after 400ms:
    bind hall_card to erpin offset 220,-360
  after 200ms:
    show image hall as hall_card at 960,520 scale 0.12 alpha 0.9
  after 500ms:
    move erpin x 1342 -> 1260 in 400ms ease Linear
  # 图片跟随父级时，仍可单独渐变自身不透明度与亮度。
  after 600ms:
    move hall_card alpha 0.9 -> 0.4 in 300ms ease Linear
    move hall_card brightness 1 -> 1.3 in 300ms ease Linear
  after 1s:
    unbind hall_card at 1180,520
  wait 1.1s

# 这是引擎绘制的遮罩转场；结束后自动进入下一句。
preset 转场·黑场 hold 0.8
transition
# wait 会保持当前舞台，等待结束后自动进入下一句。
wait 0.2s
# 没有台词的 parallel 也能运行；它会等待移动和 wait 都结束。
parallel:
  move erpin y by -20 in 0.3s ease InOutSine
  # 动作预设名称后可直接设置本次参数，不修改预设文件。
  # 拉伸倍率作用于当前大小，动作结束后保留此大小。
  move erpin preset 拉伸 duration 0.3 scaleX 1.03 scaleY 0.97
  after 0.1s:
    wait 0.3s

# 并行块也能在指定时间渐变背景与画面效果，演示后恢复。
parallel:
  after 0.2s:
    scene bg hall in 300ms ease Linear
    # 背景在 0.3 秒内交叉淡化；亮度也在同一时间逐渐变暗。
    effect brightness 1 -> 0.8 in 0.3s ease Linear
  wait 0.5s
effect reset
parallel:
  scene bg station in 300ms ease Linear
  wait 300ms

# 七、选项与跳转
# choice 下的选项必须缩进；箭头后的名称对应 label。
# jump 使两条路线汇合，避免执行另一条路线的内容。
choice "接下来去哪里？"
  "去站台查看" -> platform
  "留在候车厅" -> waiting

label platform:
  # 记录本路线的选择结果，供汇合后的 if/else 使用。
  set saw_signal = true
  narration "两人顺着灯光走到站台尽头。"
  erpin manga "原来是一盏旧信号灯。"
  ner think "灯还亮着，或许列车很快就到了。"
  jump ending

label waiting:
  scene bg hall
  narration "她们回到候车厅，等候雨势减弱。"
  ner normal "在这里至少不会淋雨。"
  erpin normal "那就一起等吧。"
  jump ending

# 八、结束与清理
# 音频停止也在下一段剧情执行；hide all 清除舞台角色。
label ending:
  camera reset
  audio stop rain fadeOut 1s
  if saw_signal:
    narration "雨声渐渐变小，信号灯仍在雨幕里闪烁。"
  else:
    narration "雨声渐渐变小，远处传来列车的汽笛。"
  # 拟声框基于游戏入场曲线重放，框体形状目前是近似绘制。
  preset 拟声框 shadowX 30 shadowY 30 shadowColor "#333333" shadowAlpha 0.7
  sfx "汽笛——" at 960,470
  hide all
  preset 全屏文字 fontSize 64 textColor "#ffffff"
  fullscreen "末班车终于来了。"
  end
