image bg_black = "assets/bg/纯黑.png"
image bg_Fta = "assets/bg/Fairy_temple_afternoon.png"
image erp_avatar = "assets/herohead/erpin.png"
image ym_avatar = "assets/herohead/YomiSkin2.png"
image vivi_avatar = "assets/herohead/ViviSkin2.png"
define erp = Spine("assets/spine\standing\erpin", name="埃尔芬",avatar=erp_avatar, avatarBg="#dd2525")
define bq = Spine("assets\spine\emoticon", name="表情")
define ym = Spine("assets/spine/standing/yomiskin2", name="优米",avatar=ym_avatar, avatarBg="#b225dd")
define vivi = Spine("assets/spine/standing/viviskin2", name="微微",avatar=vivi_avatar, avatarBg="#979797")

opening 67 "这是标题演示" hold 0 cinema on bg black
scene bg bg_Fta
location "皇宫的大厅" hold 0 uiX 0 uiY 0 uiScale 1 uiRot 0 uiOpacity 1
parallel:
  camera zoom 1
  camera zoom 1 -> 1.3 in 2s
  camera x 0 -> -220 in 0.5s
  after 200ms:
    show erp at 2000,800 face 1 pose Idle_1
    after 200ms:
      move erp x 2000 -> 960 in 2s
      camera x -220 -> 0 in 2s
  after 800ms:
    erp clear "<speed=0.5>Hello！<pause=0.2>教主，<pause=0.5>我是埃尔芬<pause=0.5>\n这是我的对话内容哦，<pause=0.5>怎么样？<pause=0.5>\n是不是挺酷的？</speed>" enter "default" exit "default" textOffsetX 0 textOffsetY 0 uiX 0 uiY 0 uiScale 1 uiRot 0 uiOpacity 1 typeSpeed 1 fontSize 52 textColor "#333333" shadowX 12.5 shadowY 12.5 shadowAlpha 0.4 shadowColor "#000000"
    after 0.2s:
      anim erp Happy_2 fade 0.25
      after 1.5s:
        anim erp Happy_5 fade 0.25
        after 1s:
          anim erp Happy_7 fade 0.25
            after 1s:
              anim erp Happy_8 fade 0.25
parallel:
  camera zoom 1.3 -> 1 in 2s
  show vivi at 2000,800 face 1 pose Tickle_Idle_1
  move erp x 800 -> 500 in 1s
  move vivi x 2000 -> 1100 in 2s
  vivi manga "扎啤吧" enter default exit default tail tr bubbleWidth 760 bubbleMinHeight 320 bubbleMaxHeight 640 bubblePaddingY 180 textWidth 580 textOffsetX 0 textOffsetY 0 uiX 0 uiY 0 uiScale 0.8 uiRot 0 uiOpacity 1 typeSpeed 1 overflow grow fontSize 52 textColor "#333333" shadowX 12.5 shadowY 12.5 shadowAlpha 0.4 shadowColor "#000000"




end
